{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "scope-empty": [2, "never"],
    "scope-enum": [
      2,
      "always",
      [
        "node",
        "pool",
        "stack",
        "deps",
        "dependencies",
        "ci",
        "release",
        "docs",
        "license",
        "repo",
        "test",
        "build",
        "security"
      ]
    ]
  }
}
